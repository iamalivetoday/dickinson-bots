# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- required ---------------------------------------------------------------

# Discord bot token: Developer Portal -> your app -> Bot -> Reset Token.
# This is a full bot credential; treat it like a password.
DISCORD_BOT_TOKEN=

# --- strongly recommended ---------------------------------------------------

# Restrict the bot to one guild. Commands sync instantly to this guild
# (global sync can take an hour), and every command and message from
# anywhere else is ignored. Right-click the server -> Copy Server ID
# (needs Discord Settings -> Advanced -> Developer Mode).
DISCORD_GUILD_ID=

# Comma-separated Discord user ids allowed to drive the bot. Empty means
# anyone in the guild can. Right-click yourself -> Copy User ID.
DISCORD_ALLOWED_USER_IDS=

# --- optional ---------------------------------------------------------------

# Needed only for actors with `backend: anthropic` in config/actors.yaml.
# Without it, those actors are simply unavailable; local actors still work.
ANTHROPIC_API_KEY=

# Which actor registry to load (default: config/actors.yaml).
# ACTORS_CONFIG_PATH=config/actors.yaml

# Where the sqlite database lives (default: data/rooms.sqlite3). Gitignored.
# ROOM_DB_PATH=data/rooms.sqlite3

# How many distinct local base models to keep loaded at once. Each 7B base
# is several GB in fp32 on MPS, so 1 is the right default on a laptop;
# raise it only if you routinely mix actors on different bases and have the
# RAM. LoRA adapters over an already-loaded base cost almost nothing extra.
# LOCAL_MAX_CACHED_BASES=1

# Force a torch device for local inference. Default: mps if available, else
# cpu. Set to "cpu" to rule out MPS-specific issues.
# LOCAL_DEVICE=
